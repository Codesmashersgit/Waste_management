# Required: set this to the reachable Next.js backend URL.
# Local phone testing: use your computer's LAN IP and keep both devices on the same network.
# Production: use the deployed HTTPS backend URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Set GEMINI_API_KEY only in the sibling Next.js backend's server-side .env file.
# Never add Gemini credentials to EXPO_PUBLIC_* or this mobile project.
