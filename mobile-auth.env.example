# Add these to the backend's existing .env file. Never put server secrets in the mobile app.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MOBILE_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=replace-with-a-server-side-gemini-api-key

# Optional: existing admin web dashboard login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret
